# CIVENTRAL - Environment Variables
# Copy this file to .env and fill in your actual values.

# Supabase Configuration (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Optional legacy CIVENTRAL MySQL fallback. Normal DRRM staging leaves this
# disabled. If enabled, every DB_* value is required and must target the
# approved existing database; no database is bundled with this project.
CIVENTRAL_LEGACY_DB_ENABLED=false
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Existing external CIVENTRAL employee API (server-side proxy target)
EXPO_PUBLIC_API_BASE_URL=https://civentral.tech/api/employee

# Google reCAPTCHA v2 checkbox for the employee/admin login only.
# Use separate key pairs per environment and never commit the secret value.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_CONNECT_TIMEOUT_MS=2000
RECAPTCHA_REQUEST_TIMEOUT_MS=5000

# Citizen session verification and browser-origin allowlist (server-side only)
CITIZEN_AUTH_PROFILE_URL=https://civentral.tech/api/citizen/get-profile.php
# Comma-separated exact origins; native Expo requests normally omit Origin.
CITIZEN_CORS_ALLOWED_ORIGINS=

# Development routing (server-side only; replace the public demo for production)
OSRM_BASE_URL=https://router.project-osrm.org

# Official DOST-PAGASA TenDay API (server-side only; approval/token required)
PAGASA_TENDAY_BASE_URL=https://tenday.pagasa.dost.gov.ph
PAGASA_API_TOKEN=

# Private TensorFlow/FastAPI service (server-side PHP-to-Python only)
CIVENTRAL_AI_BASE_URL=http://127.0.0.1:8098
CIVENTRAL_AI_INTERNAL_KEY=
CIVENTRAL_AI_CONNECT_TIMEOUT_MS=1000
CIVENTRAL_AI_REQUEST_TIMEOUT_MS=5000
