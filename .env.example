# CIVENTRAL - Environment Variables
# Copy this file to .env and fill in your actual values.

# Supabase Configuration (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Citizen session verification and browser-origin allowlist (server-side only)
CITIZEN_AUTH_PROFILE_URL=https://civentral.tech/api/citizen/get-profile.php
# Comma-separated exact origins; native Expo requests normally omit Origin.
CITIZEN_CORS_ALLOWED_ORIGINS=

# Development routing (server-side only; replace the public demo for production)
OSRM_BASE_URL=https://router.project-osrm.org

# Official DOST-PAGASA TenDay API (server-side only; approval/token required)
PAGASA_TENDAY_BASE_URL=https://tenday.pagasa.dost.gov.ph
PAGASA_API_TOKEN=

# Private TensorFlow/FastAPI service (server-side PHP-to-Python only)
CIVENTRAL_AI_BASE_URL=http://127.0.0.1:8098
CIVENTRAL_AI_INTERNAL_KEY=
CIVENTRAL_AI_CONNECT_TIMEOUT_MS=1000
CIVENTRAL_AI_REQUEST_TIMEOUT_MS=5000
