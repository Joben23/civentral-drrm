# CIVENTRAL - Environment Variables
# Copy this file to .env and fill in your actual values.

# Supabase Configuration (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Development routing (server-side only; replace the public demo for production)
OSRM_BASE_URL=https://router.project-osrm.org

# Official DOST-PAGASA TenDay API (server-side only; approval/token required)
PAGASA_TENDAY_BASE_URL=https://tenday.pagasa.dost.gov.ph
PAGASA_API_TOKEN=
