{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-pilot-dataset-manifest-v1.json",
  "title": "CIVENTRAL flood pilot dataset and quality manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "dataset_version", "created_at", "dataset_classification", "record_count",
    "positive_count", "negative_count", "unknown_event_count", "independent_event_count", "date_range",
    "spatial_coverage", "precipitation_source_coverage", "source_versions", "source_license_status",
    "label_protocol_version", "feature_schema_version", "forecast_features_status", "missingness",
    "excluded_record_count", "exclusion_reason_counts", "exclusions", "leakage_failure_count", "class_ratio",
    "dataset_sha256", "training_authorization_status", "training_ready", "tensorflow_training_performed",
    "model_artifact_created"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset_classification": {"enum": ["GOVERNED_PILOT_CANDIDATE", "TEST_ONLY_SYNTHETIC_NOT_FOR_TRAINING"]},
    "record_count": {"type": "integer", "minimum": 0},
    "positive_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "unknown_event_count": {"type": "integer", "minimum": 0},
    "independent_event_count": {"type": "integer", "minimum": 0},
    "date_range": {"type": "object"},
    "spatial_coverage": {"type": "object"},
    "precipitation_source_coverage": {"type": "object"},
    "source_versions": {"type": "object"},
    "source_license_status": {"type": "object"},
    "label_protocol_version": {"const": "1.0.0"},
    "feature_schema_version": {"const": "PILOT_CANDIDATE_FEATURES_1.0.0"},
    "forecast_features_status": {"const": "NOT_AVAILABLE_FOR_TRAINING"},
    "missingness": {"type": "object"},
    "excluded_record_count": {"type": "integer", "minimum": 0},
    "exclusion_reason_counts": {"type": "object"},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "leakage_failure_count": {"type": "integer", "minimum": 0},
    "class_ratio": {"type": "object"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "training_authorization_status": {"const": "NOT_APPROVED"},
    "training_ready": {"const": false},
    "tensorflow_training_performed": {"const": false},
    "model_artifact_created": {"const": false}
  }
}
