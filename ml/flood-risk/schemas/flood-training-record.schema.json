{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-training-record-v1.json",
  "title": "CIVENTRAL canonical flood-risk observation",
  "description": "One Caloocan spatial unit x one forecast issuance x one next-24-hour valid window. Nullable measurements are explicit missing data and are not training-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "event_id", "spatial_unit_type",
    "spatial_mapping_status", "barangay_psgc", "barangay_name",
    "forecast_issued_at", "valid_from", "valid_until",
    "forecast_rainfall_24h_mm", "antecedent_rainfall_24h_mm",
    "antecedent_rainfall_72h_mm", "rainfall_unit",
    "rainfall_metadata_status", "mgb_flood_susceptibility_code",
    "month_sin", "month_cos", "flood_outcome", "label_status",
    "label_confidence", "negative_evidence_basis", "flood_evidence_source",
    "weather_source", "susceptibility_source", "source_document_reference",
    "source_retrieved_at", "review_status", "reviewed_at", "review_notes",
    "leakage_review_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "spatial_unit_type": {"const": "BARANGAY"},
    "spatial_mapping_status": {"enum": ["VALIDATED", "UNKNOWN_SPATIAL_MAPPING"]},
    "barangay_psgc": {"type": ["string", "null"], "pattern": "^138010[0-9]{4}$"},
    "barangay_name": {"type": ["string", "null"], "minLength": 1},
    "forecast_issued_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "forecast_rainfall_24h_mm": {"type": ["number", "null"], "minimum": 0},
    "antecedent_rainfall_24h_mm": {"type": ["number", "null"], "minimum": 0},
    "antecedent_rainfall_72h_mm": {"type": ["number", "null"], "minimum": 0},
    "rainfall_unit": {"enum": ["mm", null]},
    "rainfall_metadata_status": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "mgb_flood_susceptibility_code": {"enum": ["LF", "MF", "HF", "VHF", "NONE", null]},
    "month_sin": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "month_cos": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "flood_outcome": {"enum": [0, 1, null]},
    "label_status": {"enum": ["VERIFIED_FLOOD_OBSERVED", "VERIFIED_NO_FLOOD_OBSERVED", "UNKNOWN", "AMBIGUOUS", "EXCLUDED"]},
    "label_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", null]},
    "negative_evidence_basis": {"enum": ["EXPLICIT_LGU_MONITORING_LOG", "EXPLICIT_AUTHORITATIVE_NO_FLOOD_REPORT", "VALIDATED_OBSERVATION_LOG", null]},
    "flood_evidence_source": {"type": ["string", "null"], "minLength": 1},
    "weather_source": {"type": ["string", "null"], "minLength": 1},
    "susceptibility_source": {"type": ["string", "null"], "minLength": 1},
    "source_document_reference": {"type": ["string", "null"], "minLength": 1},
    "source_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "review_status": {"enum": ["UNREVIEWED", "REQUIRES_HUMAN_REVIEW", "REVIEWED", "REJECTED"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "review_notes": {"type": ["string", "null"]},
    "leakage_review_status": {"enum": ["NOT_REVIEWED", "PASSED", "FAILED"]}
  }
}
