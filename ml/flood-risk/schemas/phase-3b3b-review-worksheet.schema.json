{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/phase-3b3b-review-worksheet-v1.json",
  "title": "CIVENTRAL Phase 3B3-B machine-assisted evidence review worksheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "worksheet_id", "event_id", "hazard_type",
    "discovery_sources", "acquisition_sources", "machine_validation",
    "report_time_evidence", "caloocan_evidence_status", "explicit_caloocan_facts",
    "occurrence_time_evidence", "location_evidence", "affected_population_evidence",
    "evacuation_displacement_evidence", "flood_passability_depth_evidence",
    "conflicting_incomplete_facts", "uncertainties", "human_review_questions",
    "positive_label_supported_by_acquired_dromic", "negative_evidence_basis",
    "label_status", "review_status", "reviewed_by", "human_approved",
    "training_eligible", "candidate_windows", "imerg_acquired_for_candidate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": "PHASE_3B3B_EVIDENCE_ACQUISITION"},
    "worksheet_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "hazard_type": {"const": "FLOOD"},
    "discovery_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discovery_source"}},
    "acquisition_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acquisition_source"}},
    "machine_validation": {"$ref": "#/$defs/machine_validation"},
    "report_time_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/report_time"}},
    "caloocan_evidence_status": {"enum": ["NO_CALOOCAN_REFERENCE_IN_ACQUIRED_DROMIC", "EXPLICIT_AFFECTED_POPULATION_ONLY", "EXPLICIT_SUPPLEMENTAL_CALOOCAN_AGGREGATES_AND_RESPONSE_ACTIONS"]},
    "explicit_caloocan_facts": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "occurrence_time_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "location_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "affected_population_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "evacuation_displacement_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "flood_passability_depth_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "conflicting_incomplete_facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "human_review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "positive_label_supported_by_acquired_dromic": {"const": false},
    "negative_evidence_basis": {"type": "null"},
    "label_status": {"const": "UNKNOWN"},
    "review_status": {"const": "REQUIRES_HUMAN_REVIEW"},
    "reviewed_by": {"type": "null"},
    "human_approved": {"const": false},
    "training_eligible": {"const": false},
    "candidate_windows": {"type": "array", "maxItems": 0},
    "imerg_acquired_for_candidate": {"const": false},
    "phase_3b3c1_temporal_assessment": {"$ref": "#/$defs/temporal_assessment"},
    "phase_3b3c1b_temporal_assessment": {"$ref": "#/$defs/enteng_temporal_assessment"},
    "phase_3b3c1c_supplemental_evidence": {"$ref": "#/$defs/enteng_supplemental_evidence"},
    "phase_3b3d_research_adjudication": {"$ref": "#/$defs/enteng_research_adjudication"}
  },
  "$defs": {
    "discovery_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "role", "access_status"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "role": {"const": "DISCOVERY_SOURCE"},
        "access_status": {"const": "EXTERNAL_ACCESS_REQUIRED"}
      }
    },
    "acquisition_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "role", "artifact_refs"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "role": {"const": "ACQUISITION_SOURCE"},
        "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "machine_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["validated_at_utc", "validator_role", "human_review_performed", "method"],
      "properties": {
        "validated_at_utc": {"type": "string", "format": "date-time"},
        "validator_role": {"const": "MACHINE_ASSISTED_EXTRACTION_NOT_HUMAN_REVIEW"},
        "human_review_performed": {"const": false},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "report_time": {
      "type": "object", "additionalProperties": false,
      "required": ["source_artifact_id", "report_title", "issue_time_source_text", "issue_timezone", "issue_time_is_event_onset"],
      "properties": {
        "source_artifact_id": {"type": "string", "minLength": 1},
        "report_title": {"type": "string", "minLength": 1},
        "issue_time_source_text": {"type": "string", "minLength": 1},
        "issue_timezone": {"type": "null"},
        "issue_time_is_event_onset": {"const": false}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "statement", "evidence_status", "source_artifact_id", "page_number"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["EXPLICITLY_STATED", "DOCUMENT_SEARCH_RESULT", "UNKNOWN"]},
        "source_artifact_id": {"type": ["string", "null"]},
        "page_number": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "temporal_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "temporal_quality", "official_source_searches", "acquired_artifact_refs",
        "source_evidence", "candidate_event_time_start", "candidate_event_time_end",
        "prediction_cutoff", "timezone_status", "location_specificity",
        "general_metro_manila_timing_is_caloocan_event_timing",
        "affected_population_establishes_onset", "human_review_required",
        "conflicts_between_report_revisions", "remaining_uncertainties",
        "recommended_human_review_questions"
      ],
      "properties": {
        "phase": {"const": "PHASE_3B3C1_ULYSSES_TEMPORAL_EVIDENCE"},
        "temporal_quality": {"enum": ["DEFENSIBLE_EVENT_TIME_ENVELOPE_FOUND", "DATE_ONLY_EVIDENCE", "TEMPORAL_EVIDENCE_INSUFFICIENT"]},
        "official_source_searches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_search"}},
        "acquired_artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/temporal_evidence"}},
        "candidate_event_time_start": {"type": ["string", "null"], "minLength": 1},
        "candidate_event_time_end": {"type": ["string", "null"], "minLength": 1},
        "prediction_cutoff": {"type": "null"},
        "timezone_status": {"const": "TIMEZONE_REQUIRES_HUMAN_REVIEW"},
        "location_specificity": {"type": "string", "minLength": 1},
        "general_metro_manila_timing_is_caloocan_event_timing": {"const": false},
        "affected_population_establishes_onset": {"const": false},
        "human_review_required": {"const": true},
        "conflicts_between_report_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "remaining_uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recommended_human_review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "enteng_temporal_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "temporal_quality", "official_source_searches",
        "raw_artifact_access_status", "acquired_artifact_refs",
        "indexed_official_content_is_raw_artifact", "exact_caloocan_records",
        "episode_clusters", "candidate_event_time_start", "candidate_event_time_end",
        "occurrence_evidence", "subsidence_evidence", "timezone_status",
        "report_issue_time_is_event_onset", "subsided_time_is_event_onset",
        "separate_date_clusters_automatically_merged", "prediction_cutoff",
        "human_review_required", "bounded_imerg_acquisition_requires_human_authorization",
        "conflicts_between_report_revisions", "remaining_uncertainties",
        "recommended_human_review_questions"
      ],
      "properties": {
        "phase": {"const": "PHASE_3B3C1B_ENTENG_TEMPORAL_EVIDENCE"},
        "temporal_quality": {"enum": ["DEFENSIBLE_EVENT_TIME_ENVELOPE_FOUND", "DATE_AND_OCCURRENCE_POINT_EVIDENCE_ONLY", "TEMPORAL_EVIDENCE_INSUFFICIENT"]},
        "official_source_searches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enteng_source_search"}},
        "raw_artifact_access_status": {"const": "EXTERNAL_ACCESS_REQUIRED"},
        "acquired_artifact_refs": {"type": "array", "maxItems": 0},
        "indexed_official_content_is_raw_artifact": {"const": false},
        "exact_caloocan_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enteng_caloocan_record"}},
        "episode_clusters": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/enteng_episode_cluster"}},
        "candidate_event_time_start": {"type": ["string", "null"], "minLength": 1},
        "candidate_event_time_end": {"type": ["string", "null"], "minLength": 1},
        "occurrence_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subsidence_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timezone_status": {"const": "TIMEZONE_REQUIRES_HUMAN_REVIEW"},
        "report_issue_time_is_event_onset": {"const": false},
        "subsided_time_is_event_onset": {"const": false},
        "separate_date_clusters_automatically_merged": {"const": false},
        "prediction_cutoff": {"type": "null"},
        "human_review_required": {"const": true},
        "bounded_imerg_acquisition_requires_human_authorization": {"const": true},
        "conflicts_between_report_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "remaining_uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recommended_human_review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "enteng_source_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_revision", "official_reference", "report_issue_time_source_text", "access_status", "indexed_content_status", "result"],
      "properties": {
        "report_revision": {"type": "string", "minLength": 1},
        "official_reference": {"type": "string", "pattern": "^https://ndrrmc\\.gov\\.ph/"},
        "report_issue_time_source_text": {"type": ["string", "null"]},
        "access_status": {"const": "EXTERNAL_ACCESS_REQUIRED"},
        "indexed_content_status": {"enum": ["OFFICIAL_INDEX_ONLY", "OFFICIAL_PDF_CONTENT_INDEXED"]},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "enteng_caloocan_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "barangay_source_text", "locality_source_text", "incident_type",
        "occurrence_date_source_text", "occurrence_time_source_text",
        "description_source_text", "remarks_source_text", "flood_status_source_text",
        "source_report_revisions", "source_access_status", "episode_cluster_id"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "barangay_source_text": {"type": ["string", "null"], "minLength": 1},
        "locality_source_text": {"type": "string", "minLength": 1},
        "incident_type": {"const": "Flooded Areas"},
        "occurrence_date_source_text": {"type": "string", "minLength": 1},
        "occurrence_time_source_text": {"type": "string", "minLength": 1},
        "description_source_text": {"type": ["string", "null"], "minLength": 1},
        "remarks_source_text": {"type": ["string", "null"], "minLength": 1},
        "flood_status_source_text": {"type": "string", "minLength": 1},
        "source_report_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_access_status": {"const": "INDEXED_OFFICIAL_CONTENT_ONLY"},
        "episode_cluster_id": {"type": "string", "minLength": 1}
      }
    },
    "enteng_episode_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_cluster_id", "assessment", "record_ids", "candidate_event_time_start", "candidate_event_time_end", "end_interpretation", "human_review_required"],
      "properties": {
        "episode_cluster_id": {"type": "string", "minLength": 1},
        "assessment": {"enum": ["BOUNDED_PRIMARY_EPISODE", "SEPARATE_LATER_OCCURRENCE_REQUIRES_REVIEW"]},
        "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "candidate_event_time_start": {"type": ["string", "null"], "minLength": 1},
        "candidate_event_time_end": {"type": ["string", "null"], "minLength": 1},
        "end_interpretation": {"type": "string", "minLength": 1},
        "human_review_required": {"const": true}
      }
    },
    "enteng_supplemental_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "source_id", "artifact_id", "source_classification",
        "evidence_role", "page_count", "internal_title",
        "report_issue_time_source_text", "report_issue_timezone",
        "report_issue_time_is_event_onset", "affected_population_snapshot",
        "response_actions", "additional_caloocan_facts",
        "defines_02_september_onset", "defines_03_september_upper_bound",
        "resolves_ndrrmc_timezone", "merges_crispulo_cluster",
        "preserved_candidate_event_time_start", "preserved_candidate_event_time_end",
        "timezone_status", "prediction_cutoff", "human_review_required"
      ],
      "properties": {
        "phase": {"const": "PHASE_3B3C1C_ENTENG_SUPPLEMENTAL_RAW_EVIDENCE"},
        "source_id": {"const": "dswd_dromic_enteng_2024_report_41"},
        "artifact_id": {"const": "dswd_dromic_enteng_2024_report_41"},
        "source_classification": {"const": "OFFICIAL_DSWD_DROMIC"},
        "evidence_role": {"const": "SUPPLEMENTAL_CORROBORATION"},
        "page_count": {"const": 46},
        "internal_title": {"type": "string", "minLength": 1},
        "report_issue_time_source_text": {"const": "as of 13 October 2024, 6AM"},
        "report_issue_timezone": {"type": "null"},
        "report_issue_time_is_event_onset": {"const": false},
        "affected_population_snapshot": {"$ref": "#/$defs/enteng_affected_population_snapshot"},
        "response_actions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/enteng_response_action"}},
        "additional_caloocan_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enteng_additional_fact"}},
        "defines_02_september_onset": {"const": false},
        "defines_03_september_upper_bound": {"const": false},
        "resolves_ndrrmc_timezone": {"const": false},
        "merges_crispulo_cluster": {"const": false},
        "preserved_candidate_event_time_start": {"type": "string", "minLength": 1},
        "preserved_candidate_event_time_end": {"type": "string", "minLength": 1},
        "timezone_status": {"const": "TIMEZONE_REQUIRES_HUMAN_REVIEW"},
        "prediction_cutoff": {"type": "null"},
        "human_review_required": {"const": true}
      }
    },
    "enteng_affected_population_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number", "location_source_text", "affected_barangays", "affected_families", "affected_persons", "represents_conditions_on_02_september", "establishes_flood_onset"],
      "properties": {
        "page_number": {"const": 15},
        "location_source_text": {"const": "Caloocan City"},
        "affected_barangays": {"const": 6},
        "affected_families": {"const": 3250},
        "affected_persons": {"const": 12754},
        "represents_conditions_on_02_september": {"const": false},
        "establishes_flood_onset": {"const": false}
      }
    },
    "enteng_response_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number", "date_source_text", "action_source_text", "is_flood_occurrence_time"],
      "properties": {
        "page_number": {"const": 3},
        "date_source_text": {"enum": ["03 September 2024", "06 September 2024", "07 September 2024"]},
        "action_source_text": {"type": "string", "minLength": 1},
        "is_flood_occurrence_time": {"const": false}
      }
    },
    "enteng_additional_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number", "statement", "temporal_interpretation"],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1, "maximum": 46},
        "statement": {"type": "string", "minLength": 1},
        "temporal_interpretation": {"enum": ["LATER_CUMULATIVE_SNAPSHOT_NOT_EVENT_TIME", "CUMULATIVE_ASSISTANCE_NOT_EVENT_TIME"]}
      }
    },
    "enteng_research_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "decision_scope", "decision_type", "decision_status",
        "rainfall_acquisition_authorization", "decision_authority",
        "adjudicator_identity", "official_lgu_reviewer", "official_lgu_approval",
        "operational_use_approved", "training_use_approved", "human_approval_claimed",
        "accepted_evidence_basis", "primary_episode", "source_time_handling",
        "exploratory_acquisition_window", "authorized_actions", "prohibited_actions",
        "limitations", "label_status_after_decision", "review_status_after_decision",
        "human_approved_after_decision", "training_eligible_after_decision",
        "prediction_cutoff", "training_ready_after_decision",
        "training_authorization_after_decision", "model_status_after_decision"
      ],
      "properties": {
        "phase": {"const": "PHASE_3B3D_ENTENG_PROJECT_RESEARCH_ADJUDICATION"},
        "decision_scope": {"const": "PROJECT_RESEARCH_ONLY"},
        "decision_type": {"const": "EXPLORATORY_RAINFALL_ACQUISITION_AUTHORIZATION"},
        "decision_status": {"const": "AUTHORIZED_WITH_STRICT_LIMITATIONS"},
        "rainfall_acquisition_authorization": {"const": "APPROVED_FOR_PROJECT_RESEARCH_ONLY"},
        "decision_authority": {"const": "PROJECT_RESEARCH_GOVERNANCE_POLICY"},
        "adjudicator_identity": {"type": "null"},
        "official_lgu_reviewer": {"type": "null"},
        "official_lgu_approval": {"const": false},
        "operational_use_approved": {"const": false},
        "training_use_approved": {"const": false},
        "human_approval_claimed": {"const": false},
        "accepted_evidence_basis": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/research_evidence_basis"}},
        "primary_episode": {"$ref": "#/$defs/research_primary_episode"},
        "source_time_handling": {"$ref": "#/$defs/research_time_handling"},
        "exploratory_acquisition_window": {"$ref": "#/$defs/research_acquisition_window"},
        "authorized_actions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["RETRIEVE_BOUNDED_HISTORICAL_RAINFALL", "CHECKSUM_AND_VALIDATE_RAINFALL_OBSERVATIONS", "ASSESS_SPATIAL_AND_TEMPORAL_COVERAGE", "INSPECT_EXPLORATORY_RAINFALL_PATTERNS"]}},
        "prohibited_actions": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"enum": ["CREATE_TRAINING_ROWS", "ASSIGN_FLOOD_CONFIRMED", "ASSIGN_NO_FLOOD_CONFIRMED", "CREATE_PREDICTION_CUTOFF", "TRAIN_TENSORFLOW", "CALIBRATE_MODEL", "EXPOSE_PREDICTION_PROBABILITY", "ACTIVATE_MODEL", "USE_FOR_OPERATIONS"]}},
        "limitations": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
        "label_status_after_decision": {"const": "UNKNOWN"},
        "review_status_after_decision": {"const": "REQUIRES_HUMAN_REVIEW"},
        "human_approved_after_decision": {"const": false},
        "training_eligible_after_decision": {"const": false},
        "prediction_cutoff": {"type": "null"},
        "training_ready_after_decision": {"const": false},
        "training_authorization_after_decision": {"const": "NOT_APPROVED"},
        "model_status_after_decision": {"const": "MODEL_NOT_AVAILABLE"}
      }
    },
    "research_evidence_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "evidence_role", "access_status", "raw_artifact_acquired", "accepted_use", "limitation"],
      "properties": {
        "source_id": {"enum": ["ndrrmc_enteng_sitreps_2024", "dswd_dromic_enteng_2024_report_41"]},
        "evidence_role": {"enum": ["PRIMARY_TEMPORAL_DISCOVERY_EVIDENCE", "SUPPLEMENTAL_CORROBORATION"]},
        "access_status": {"enum": ["INDEXED_OFFICIAL_CONTENT_ONLY", "ACQUIRED"]},
        "raw_artifact_acquired": {"type": "boolean"},
        "accepted_use": {"enum": ["EXPLORATORY_TEMPORAL_ALIGNMENT_ONLY", "CALOOCAN_IMPACT_CORROBORATION_ONLY"]},
        "limitation": {"type": "string", "minLength": 1}
      }
    },
    "research_primary_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_cluster_id", "candidate_event_time_start", "start_interpretation", "candidate_event_time_end", "end_interpretation", "crispulo_cluster_id", "crispulo_excluded", "crispulo_merged"],
      "properties": {
        "episode_cluster_id": {"const": "enteng-caloocan-2024-09-02-primary"},
        "candidate_event_time_start": {"type": "string", "minLength": 1},
        "start_interpretation": {"type": "string", "minLength": 1},
        "candidate_event_time_end": {"type": "string", "minLength": 1},
        "end_interpretation": {"type": "string", "minLength": 1},
        "crispulo_cluster_id": {"const": "enteng-caloocan-2024-09-05-crispulo-review"},
        "crispulo_excluded": {"const": true},
        "crispulo_merged": {"const": false}
      }
    },
    "research_time_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_timezone", "source_timestamps_preserved_unchanged", "research_alignment_timezone", "research_alignment_utc_offset", "timezone_basis", "claimed_as_explicit_source_metadata", "source_corrected", "formal_confirmation_required_for_training_or_operations"],
      "properties": {
        "source_timezone": {"const": "UNSPECIFIED"},
        "source_timestamps_preserved_unchanged": {"const": true},
        "research_alignment_timezone": {"const": "Asia/Manila"},
        "research_alignment_utc_offset": {"const": "+08:00"},
        "timezone_basis": {"const": "PROJECT_RESEARCH_ASSUMPTION"},
        "claimed_as_explicit_source_metadata": {"const": false},
        "source_corrected": {"const": false},
        "formal_confirmation_required_for_training_or_operations": {"const": true}
      }
    },
