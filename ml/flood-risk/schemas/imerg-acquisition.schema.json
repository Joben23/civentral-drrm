{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/imerg-exploratory-acquisition-v1.json",
  "title": "CIVENTRAL governed IMERG exploratory acquisition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "acquisition_id", "source_id", "status", "acquisition_type", "product", "access", "acquisition_window", "spatial_request", "artifact_ids", "normalization", "validated_coverage", "training_effect"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "acquisition_id": {"type": "string", "minLength": 1},
    "source_id": {"const": "nasa_gpm_imerg_final_hh_v07"},
    "status": {"const": "ACQUIRED_TECHNICALLY_VALIDATED_REVIEW_PENDING"},
    "acquisition_type": {"const": "EXPLORATORY_SOURCE_ACQUISITION_WINDOW"},
    "product": {"type": "object", "required": ["short_name", "collection_version", "processing_id", "doi", "run", "data_characterization", "spatial_resolution_degrees", "temporal_resolution_minutes", "variable_name", "native_units", "time_semantics", "historical_coverage_start", "official_metadata_urls"]},
    "access": {"type": "object", "additionalProperties": false, "required": ["original_granule_access", "authentication_material_present", "original_granule_downloaded", "representation", "public_subset_service", "access_note"], "properties": {"original_granule_access": {"const": "EARTHDATA_AUTHENTICATION_REQUIRED"}, "authentication_material_present": {"const": false}, "original_granule_downloaded": {"const": false}, "representation": {"const": "OFFICIAL_EARTHDATA_IMAGESERVER_SAMPLES"}, "public_subset_service": {"type": "string", "pattern": "^https://gis\\.earthdata\\.nasa\\.gov/"}, "access_note": {"type": "string", "minLength": 1}}},
    "acquisition_window": {"type": "object", "required": ["classification", "start_utc", "end_utc_exclusive", "source_date_text", "source_timezone", "timezone_assumption_status", "conversion_method", "selection_rationale", "target_window", "prediction_window", "training_window"]},
    "spatial_request": {"type": "object", "required": ["crs", "city_boundary_source", "city_boundary_sha256", "city_bounds_wgs84", "requested_bounds_wgs84", "source_resolution_degrees", "requested_grid_centers", "neighbor_rationale", "mapping_method_selected", "coarse_resolution_limitation_retained", "limitation_note"]},
    "artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "normalization": {"type": "object", "required": ["source_variable_verified", "source_units_verified", "native_value_field", "native_units", "normalized_units", "interval_hours", "formula", "preserve_native_value_and_units", "missing_fill_policy", "quality_status", "observed_forecast_separation"]},
    "validated_coverage": {"type": "object", "required": ["expected_interval_count_per_cell", "expected_grid_cell_count", "expected_observation_count", "raw_sample_chunk_count", "quarantined_incomplete_response_count", "source_checksum_status", "coverage_status"]},
    "training_effect": {"type": "object", "additionalProperties": false, "required": ["creates_training_row", "sets_event_label", "sets_training_ready", "authorizes_training"], "properties": {"creates_training_row": {"const": false}, "sets_event_label": {"const": false}, "sets_training_ready": {"const": false}, "authorizes_training": {"const": false}}}
  }
}
