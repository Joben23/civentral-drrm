{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-pilot-dataset-record-v1.json",
  "title": "CIVENTRAL non-authorized flood pilot candidate row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "event_id", "window_id", "prediction_cutoff", "target_window_start",
    "target_window_end", "forecast_horizon_hours", "location_scope", "barangay_psgc",
    "latitude", "longitude", "label_status", "flood_outcome", "precipitation_data_type",
    "precipitation_source_id", "precipitation_product_version", "mapping_method",
    "mapping_version", "source_resolution", "source_grid_cells_json", "mapping_distance_m",
    "mapping_coverage_fraction", "mapping_limitation_note", "rainfall_1h_mm",
    "rainfall_3h_mm", "rainfall_6h_mm", "rainfall_12h_mm", "rainfall_24h_mm",
    "rainfall_72h_mm", "label_protocol_version"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "event_id": {"type": "string"},
    "window_id": {"type": "string"},
    "prediction_cutoff": {"type": "string", "format": "date-time"},
    "target_window_start": {"type": "string", "format": "date-time"},
    "target_window_end": {"type": "string", "format": "date-time"},
    "forecast_horizon_hours": {"type": "number", "exclusiveMinimum": 0},
    "location_scope": {"enum": ["CITY", "BARANGAY", "MULTI_BARANGAY", "POINT"]},
    "barangay_psgc": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "label_status": {"enum": ["FLOOD_CONFIRMED", "NO_FLOOD_CONFIRMED"]},
    "flood_outcome": {"enum": [0, 1]},
    "precipitation_data_type": {"const": "OBSERVED_PRECIPITATION"},
    "precipitation_source_id": {"type": "string"},
    "precipitation_product_version": {"type": "string"},
    "mapping_method": {"enum": ["POINT_CONTAINING_CELL", "NEAREST_VALID_CELL", "AREA_WEIGHTED_POLYGON"]},
    "mapping_version": {"type": "string"},
    "source_resolution": {"type": "string"},
    "source_grid_cells_json": {"type": "string"},
    "mapping_distance_m": {"type": ["number", "null"], "minimum": 0},
    "mapping_coverage_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "mapping_limitation_note": {"type": "string", "minLength": 1},
    "rainfall_1h_mm": {"type": "number", "minimum": 0},
    "rainfall_3h_mm": {"type": "number", "minimum": 0},
    "rainfall_6h_mm": {"type": "number", "minimum": 0},
    "rainfall_12h_mm": {"type": "number", "minimum": 0},
    "rainfall_24h_mm": {"type": "number", "minimum": 0},
    "rainfall_72h_mm": {"type": "number", "minimum": 0},
    "label_protocol_version": {"const": "1.0.0"}
  }
}
