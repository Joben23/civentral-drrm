{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-event-registry-v1.json",
  "title": "CIVENTRAL reviewed flood event registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "label_protocol_version", "dataset_classification", "training_authorization_status", "events"],
  "properties": {
    "registry_version": {"const": "1.0.0"},
    "label_protocol_version": {"const": "1.0.0"},
    "dataset_classification": {"enum": ["GOVERNED_EVENT_CANDIDATES", "TEST_ONLY_SYNTHETIC_NOT_FOR_TRAINING"]},
    "training_authorization_status": {"const": "NOT_APPROVED"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "candidate_reference", "hazard_type", "event_start", "event_end", "event_time_status",
          "location_scope", "barangay_psgc", "latitude", "longitude", "source_ids", "source_document_refs",
          "evidence_summary", "label_status", "negative_evidence_basis", "review_status", "reviewed_by",
          "reviewed_at", "leakage_review_status", "training_eligible", "exclusion_reason", "candidate_windows"
        ],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
          "candidate_reference": {"type": ["string", "null"]},
          "hazard_type": {"const": "FLOOD"},
          "event_start": {"type": ["string", "null"], "format": "date-time"},
          "event_end": {"type": ["string", "null"], "format": "date-time"},
          "event_time_status": {"enum": ["UNRESOLVED", "APPROXIMATE", "VALIDATED"]},
          "location_scope": {"enum": ["UNKNOWN", "CITY", "BARANGAY", "MULTI_BARANGAY", "POINT"]},
          "barangay_psgc": {"type": ["string", "null"], "pattern": "^138010[0-9]{4}$"},
          "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
          "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "source_document_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_summary": {"type": "string", "minLength": 1},
          "label_status": {"enum": ["FLOOD_CONFIRMED", "NO_FLOOD_CONFIRMED", "UNKNOWN"]},
          "negative_evidence_basis": {"enum": ["EXPLICIT_LGU_MONITORING_NO_FLOOD", "EXPLICIT_AUTHORITATIVE_SITUATION_LOG_NO_FLOOD", "HUMAN_REVIEWED_AUTHORITATIVE_MONITORING_NO_FLOOD", null]},
          "review_status": {"enum": ["UNREVIEWED", "REQUIRES_HUMAN_REVIEW", "REVIEWED", "REJECTED"]},
          "reviewed_by": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
          "leakage_review_status": {"enum": ["NOT_REVIEWED", "PASSED", "FAILED"]},
          "training_eligible": {"type": "boolean"},
          "exclusion_reason": {"type": ["string", "null"]},
          "candidate_windows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["window_id", "prediction_cutoff", "target_window_start", "target_window_end", "label_observed_at", "forecast_horizon_hours", "precipitation_mapping"],
              "properties": {
                "window_id": {"type": "string"},
                "prediction_cutoff": {"type": "string", "format": "date-time"},
                "target_window_start": {"type": "string", "format": "date-time"},
                "target_window_end": {"type": "string", "format": "date-time"},
                "label_observed_at": {"type": "string", "format": "date-time"},
                "forecast_horizon_hours": {"type": "number", "exclusiveMinimum": 0},
                "precipitation_mapping": {"$ref": "#/$defs/precipitation_mapping"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "precipitation_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "mapping_method", "mapping_version", "source_resolution", "source_grid_cells", "distance_m", "coverage_fraction", "limitation_note"],
      "properties": {
        "source_id": {"type": "string"},
        "mapping_method": {"enum": ["POINT_CONTAINING_CELL", "NEAREST_VALID_CELL", "AREA_WEIGHTED_POLYGON"]},
        "mapping_version": {"type": "string", "minLength": 1},
        "source_resolution": {"type": "string", "minLength": 1},
        "source_grid_cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grid_cell_id", "weight"],
            "properties": {
              "grid_cell_id": {"type": "string", "minLength": 1},
              "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          }
        },
        "distance_m": {"type": ["number", "null"], "minimum": 0},
        "coverage_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "limitation_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
