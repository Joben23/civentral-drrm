# Private development bind. Keep 127.0.0.1 for XAMPP development.
CIVENTRAL_AI_HOST=127.0.0.1
CIVENTRAL_AI_PORT=8098
CIVENTRAL_AI_ALLOW_PUBLIC_BIND=false

# Internal PHP-to-Python authentication. Replace locally with a random secret.
# This is an example, not a real credential.
CIVENTRAL_AI_REQUIRE_INTERNAL_AUTH=true
CIVENTRAL_AI_INTERNAL_KEY=replace-with-a-random-server-side-secret-at-least-32-characters

# Leave model/policy paths empty until approved artifacts exist.
CIVENTRAL_AI_MODEL_PATH=
CIVENTRAL_AI_MODEL_MANIFEST_PATH=
CIVENTRAL_AI_RISK_POLICY_PATH=

# Optional overrides. Defaults already point to the Phase 7B contracts.
CIVENTRAL_AI_ARTIFACT_ROOT=
CIVENTRAL_AI_FEATURE_SCHEMA_PATH=
CIVENTRAL_AI_BARANGAY_REFERENCE_PATH=

CIVENTRAL_AI_MAX_REQUEST_BYTES=16384
CIVENTRAL_AI_ENABLE_DOCS=false
CIVENTRAL_AI_LOG_LEVEL=INFO
