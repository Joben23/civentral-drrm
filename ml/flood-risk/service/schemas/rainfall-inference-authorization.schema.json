{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.local/schemas/rainfall-inference-authorization.schema.json",
  "title": "CIVENTRAL private research rainfall inference authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "recorded_at_utc",
    "decision_scope",
    "authorization_type",
    "status",
    "authorized_model_version",
    "private_internal_inference",
    "operational_use_approved",
    "public_use_approved",
    "citizen_direct_access_approved",
    "flood_classifier_approved",
    "mgb_fusion_approved",
    "emergency_decision_approved",
    "global_training_ready",
    "global_training_authorization",
    "statement"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": "TENSORFLOW_PHASE_3F_B"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "decision_scope": {"const": "PROJECT_RESEARCH_ONLY"},
    "authorization_type": {"const": "PRIVATE_RAINFALL_REGRESSION_INFERENCE"},
    "status": {"const": "APPROVED_FOR_PRIVATE_PROJECT_RESEARCH_ONLY"},
    "authorized_model_version": {"const": "rainfall-regression-dense-57-v0.1.1-softplus-candidate"},
    "private_internal_inference": {"const": true},
    "operational_use_approved": {"const": false},
    "public_use_approved": {"const": false},
    "citizen_direct_access_approved": {"const": false},
    "flood_classifier_approved": {"const": false},
    "mgb_fusion_approved": {"const": false},
    "emergency_decision_approved": {"const": false},
    "global_training_ready": {"const": false},
    "global_training_authorization": {"const": "NOT_APPROVED"},
    "statement": {"type": "string", "minLength": 1}
  }
}
