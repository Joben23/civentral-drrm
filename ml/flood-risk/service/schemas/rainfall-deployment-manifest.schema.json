{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.local/schemas/rainfall-deployment-manifest.schema.json",
  "title": "CIVENTRAL rainfall regression deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_problem",
    "model_version",
    "model_status",
    "model",
    "preprocessing",
    "feature_count",
    "history_intervals",
    "interval_minutes",
    "output_policy",
    "target",
    "forecast_horizon_hours",
    "architecture",
    "operational",
    "public_use_approved",
    "flood_classifier",
    "mgb_fusion_approved"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_problem": {"const": "RAINFALL_REGRESSION"},
    "model_version": {"const": "rainfall-regression-dense-57-v0.1.1-softplus-candidate"},
    "model_status": {"const": "VALIDATED_RESEARCH_CANDIDATE"},
    "model": {"$ref": "#/$defs/file"},
    "preprocessing": {"$ref": "#/$defs/file"},
    "feature_count": {"const": 57},
    "history_intervals": {"const": 48},
    "interval_minutes": {"const": 30},
    "output_policy": {"const": "MODEL_NONNEGATIVE_SOFTPLUS"},
    "target": {"const": "NEXT_3_HOUR_ACCUMULATED_RAINFALL_MM"},
    "forecast_horizon_hours": {"const": 3},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dense_units", "activations", "parameter_count", "tensorflow_version"],
      "properties": {
        "type": {"const": "SMALL_DENSE_REGRESSION"},
        "dense_units": {"const": [64, 32, 1]},
        "activations": {"const": ["relu", "relu", "softplus"]},
        "parameter_count": {"const": 5825},
        "tensorflow_version": {"const": "2.21.0"}
      }
    },
    "operational": {"const": false},
    "public_use_approved": {"const": false},
    "flood_classifier": {"const": false},
    "mgb_fusion_approved": {"const": false}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "byte_length"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    }
  }
}
