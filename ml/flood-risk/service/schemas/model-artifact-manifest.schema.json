{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-model-artifact-manifest-v1.json",
  "title": "CIVENTRAL flood-risk TensorFlow artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version", "model_id", "model_version", "task_type",
    "model_status", "input_schema_version", "feature_order",
    "training_dataset_version", "training_dataset_hash",
    "label_protocol_version", "created_at", "forecast_horizon_hours",
    "calibration_status",
    "tensorflow_version", "python_version", "artifact_filename",
    "artifact_format", "artifact_sha256", "approved_for_operational_use",
    "threshold_policy_version", "input_shape", "output_semantics",
    "preprocessing_artifact_format", "preprocessing_artifact_filename",
    "preprocessing_artifact_checksum",
    "limitations"
  ],
  "properties": {
    "manifest_schema_version": {"const": "1.1"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_type": {"const": "FLOOD_RISK_CLASSIFIER"},
    "model_status": {"enum": ["DEVELOPMENT_NOT_OPERATIONALLY_VALIDATED", "OPERATIONALLY_VALIDATED"]},
    "input_schema_version": {"const": "1.0.0"},
    "feature_order": {
      "const": [
        "forecast_rainfall_24h_mm", "antecedent_rainfall_24h_mm",
        "antecedent_rainfall_72h_mm", "mgb_susceptibility_LF",
        "mgb_susceptibility_MF", "mgb_susceptibility_HF",
        "mgb_susceptibility_VHF", "mgb_susceptibility_NONE",
        "month_sin", "month_cos"
      ]
    },
    "training_dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "training_dataset_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "label_protocol_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "forecast_horizon_hours": {"const": 24},
    "calibration_status": {"enum": ["NOT_VALIDATED", "RESEARCH_VALIDATED", "OPERATIONALLY_VALIDATED"]},
    "tensorflow_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "artifact_filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.keras$"},
    "artifact_format": {"const": "KERAS_V3"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_for_operational_use": {"type": "boolean"},
    "threshold_policy_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "input_shape": {"const": 10},
    "output_semantics": {"const": "FLOOD_PROBABILITY"},
    "preprocessing_artifact_format": {"enum": ["STANDARD_SCALER_JSON", null]},
    "preprocessing_artifact_filename": {"type": ["string", "null"]},
    "preprocessing_artifact_checksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
