{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civentral.invalid/schemas/flood-risk-policy-v1.json",
  "title": "CIVENTRAL probability-to-risk policy",
  "description": "Schema only. No policy instance or threshold values exist in Phase 7D-A.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_schema_version", "policy_version", "policy_status",
    "approved_for_inference", "approved_at", "compatible_model_versions",
    "flood_outcome_threshold", "moderate_min_probability",
    "high_min_probability", "critical_min_probability", "limitations"
  ],
  "properties": {
    "policy_schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_status": {"enum": ["DEVELOPMENT_NOT_APPROVED", "OPERATIONALLY_APPROVED"]},
    "approved_for_inference": {"type": "boolean"},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "compatible_model_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "flood_outcome_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "moderate_min_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "high_min_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "critical_min_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
